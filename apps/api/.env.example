# GBS Enterprise API — Environment Variables Reference
# Copy this file to .env and fill in your values before starting the server.
# CRITICAL: Never commit your actual .env file to version control.

# ── Server ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── Database ───────────────────────────────────────────────────────────────
# SQLite (development only)
DATABASE_URL="file:./dev.db"
# PostgreSQL (production)
# DATABASE_URL="postgresql://postgres:password@localhost:5432/enterprise_db"

# ── Redis ──────────────────────────────────────────────────────────────────
# Required for: idempotency cache, session management, permission cache
REDIS_URL="redis://localhost:6379"
# With password (production)
# REDIS_URL="redis://:your_redis_password@localhost:6379"

# ── Authentication ─────────────────────────────────────────────────────────
# CRITICAL: Must be a strong random secret (min 32 chars) in production
# Generate with: openssl rand -base64 48
JWT_SECRET="REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_32_CHARS"
JWT_EXPIRES_IN="24h"
JWT_REFRESH_EXPIRES_IN="7d"

# ── RBAC Cache ─────────────────────────────────────────────────────────────
# Permission cache TTL in seconds (default: 300 = 5 minutes)
RBAC_CACHE_TTL_SECONDS=300
# Strict by default: Super Admin does not enter role-isolated portals unless
# platform policy explicitly enables cross-portal support access.
ALLOW_SUPER_ADMIN_PORTAL_ACCESS=false

# ── Google OAuth SSO ──────────────────────────────────────────────────────
# Required for Google Sign-In. Get from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional dedicated state-signing secret. If omitted, the API uses JWT_SECRET.
GOOGLE_OAUTH_STATE_SECRET=""

# ── Apple Sign In ─────────────────────────────────────────────────────────
# Required for Apple SSO. Get from: https://developer.apple.com/
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
# Path to your Apple private key .p8 file
APPLE_PRIVATE_KEY_PATH=""

# ── Microsoft/Azure AD SSO ────────────────────────────────────────────────
# Required for Microsoft SSO. Get from: https://portal.azure.com/
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""
AZURE_TENANT_ID=""

# ── GitHub OAuth ──────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ── AI Providers ──────────────────────────────────────────────────────────
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Text + image generation used by "Post Content".
# auto prefers Gemini when both providers are configured, then fails over to OpenAI.
AI_CONTENT_PROVIDER="auto"
GEMINI_IMAGE_MODEL="gemini-3.1-flash-image"
OPENAI_TEXT_MODEL="gpt-5-mini"
OPENAI_IMAGE_MODEL="gpt-image-1"

# ── Google Business Profile ───────────────────────────────────────────────
GBP_SERVICE_ACCOUNT_KEY_PATH=""
GOOGLE_BUSINESS_API_KEY=""
GOOGLE_REDIRECT_URI="http://localhost:4000/api/v1/google/callback"

# ── Social provider applications ─────────────────────────────────────────
# Provider OAuth callbacks remain disabled until the corresponding verified
# server-side token-exchange adapter is configured; never place these in a portal.
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""
PINTEREST_APP_ID=""
PINTEREST_APP_SECRET=""
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
THREADS_APP_ID=""
THREADS_APP_SECRET=""
YOUTUBE_MAX_UPLOAD_BYTES=104857600

# ── Email (SMTP) ──────────────────────────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@yourdomain.com"

# ── SMS / Twilio ──────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
TWILIO_WHATSAPP_NUMBER=""

# Review-request delivery adapter. The endpoint must accept the documented JSON
# payload and return HTTP 2xx only after the email/SMS/WhatsApp provider accepts it.
REVIEW_REQUEST_WEBHOOK_URL=""
REVIEW_REQUEST_WEBHOOK_TOKEN=""

# Optional analytics provider adapters. Without these, report delivery and
# warehouse sync endpoints return HTTP 503 instead of fabricating success.
ANALYTICS_REPORT_DELIVERY_WEBHOOK_URL=""
BI_SYNC_WEBHOOK_URL=""

# Optional partner team invitation delivery provider. Without it, invitations
# are persisted as pending and the API returns HTTP 202 with NOT_CONFIGURED.
TEAM_INVITE_DELIVERY_WEBHOOK_URL=""
TEAM_INVITE_DELIVERY_WEBHOOK_TOKEN=""

# Tenant that receives public website demo/contact leads. Local development
# falls back only to the seeded `demo` tenant; production requires this value.
LEADS_TENANT_ID=""

# ── File Storage ──────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""
AWS_S3_REGION="us-east-1"

# Generated social images are served by the API in local development.
# In production, set PUBLIC_API_URL to a public HTTPS origin reachable by social networks.
PUBLIC_API_URL="http://localhost:4000"
# GENERATED_MEDIA_DIR="C:\\absolute\\private\\storage\\generated-media"

# ── Billing / Stripe ──────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ── Portal URLs (for CORS) ────────────────────────────────────────────────
ADMIN_URL="http://localhost:3000"
PARTNER_URL="http://localhost:3001"
CUSTOMER_URL="http://localhost:3002"
WEB_URL="http://localhost:3003"

# ── Encryption ────────────────────────────────────────────────────────────
# Used for encrypting sensitive data at rest
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY="REPLACE_WITH_32_BYTE_HEX_KEY"

# ── Worker Configuration ──────────────────────────────────────────────────
SOCIAL_PUBLISHER_INTERVAL_MS=60000
GBP_SYNC_INTERVAL_MS=300000

# ── Feature Flags ─────────────────────────────────────────────────────────
ENABLE_MFA=true
ENABLE_CAPTCHA=true
ENABLE_AUDIT_LOGGING=true
