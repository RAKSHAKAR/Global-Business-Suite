/// Report Definition for Visual Report Builder
model ReportDefinition {
  id                String   @id @default(uuid())
  tenantId          String?
  key               String?  @unique
  title             String
  description       String?
  category          String   @default("GENERAL") // USERS, PARTNERS, CUSTOMERS, ORGANIZATIONS, SUBSCRIPTIONS, REVENUE, INVOICES, PAYMENTS, CRM, LEADS, SALES, MARKETING, GBP, SOCIAL, REVIEWS, APPOINTMENTS, SUPPORT, AI, NOTIFICATIONS, AUTOMATION, API, SECURITY, AUDIT, PERFORMANCE, MOBILE
  reportType        String   @default("TABLE") // TABLE, CHART, PIVOT, MATRIX, HEATMAP, KPI_CARD, FUNNEL, GEOMAP, TIMELINE, CUSTOM_SQL
  chartType         String?  @default("BAR") // BAR, LINE, PIE, AREA, SCATTER, DONUT, RADAR, GAUGE
  sqlQuery          String? // Admin-only custom SQL query string
  queryConfigJson   String   @default("{}") // Visual query configuration JSON (dimensions, measures, filters, sort)
  filtersJson       String   @default("[]") // Default report filter conditions
  columnsJson       String   @default("[]") // Visible table/matrix columns
  vizConfigJson     String   @default("{}") // Chart colors, axes, legend, formatting config
  isSystemReport    Boolean  @default(false)
  isPublic          Boolean  @default(false)
  ownerUserId       String?
  sharedRoleIdsJson String   @default("[]")
  tagsJson          String   @default("[]")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  executions ReportExecutionLog[]

  @@index([tenantId])
  @@index([category])
  @@index([reportType])
}

/// Audit history log for report queries and exports
model ReportExecutionLog {
  id            String           @id @default(uuid())
  reportId      String
  report        ReportDefinition @relation(fields: [reportId], references: [id], onDelete: Cascade)
  tenantId      String?
  executedBy    String?
  executionType String           @default("MANUAL") // MANUAL, SCHEDULED, EXPORT, API
  exportFormat  String?          @default("JSON") // JSON, PDF, EXCEL, CSV, PRINT
  durationMs    Int              @default(0)
  rowCount      Int              @default(0)
  status        String           @default("SUCCESS") // SUCCESS, ERROR, CANCELLED
  errorMessage  String?
  createdAt     DateTime         @default(now())

  @@index([reportId])
  @@index([tenantId])
  @@index([executedBy])
  @@index([createdAt])
}

/// Configurable KPI Definition
model KpiDefinition {
  id                String   @id @default(uuid())
  tenantId          String?
  key               String   @unique // REVENUE_MRR, REVENUE_ARR, CHURN_RATE, LTV, ARPU, LEAD_CONVERSION, GBP_RATING, CSAT, NPS, API_SLA, etc.
  name              String
  description       String?
  category          String   @default("FINANCIAL") // FINANCIAL, CRM, MARKETING, GBP, SOCIAL, AI, SYSTEM, CUSTOMER_SUCCESS, SUPPORT, SECURITY
  metricType        String   @default("CURRENCY") // CURRENCY, PERCENTAGE, COUNT, DURATION, SCORE, RATIO
  unit              String?  @default("USD")
  queryConfigJson   String   @default("{}")
  targetValue       Float?
  warningThreshold  Float?
  criticalThreshold Float?
  trendPeriodDays   Int      @default(30)
  isSystem          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  history KpiHistory[]

  @@index([tenantId])
  @@index([category])
}

/// Periodic snapshot history for KPI trends and predictive modeling
model KpiHistory {
  id          String        @id @default(uuid())
  kpiId       String
  kpi         KpiDefinition @relation(fields: [kpiId], references: [id], onDelete: Cascade)
  tenantId    String?
  value       Float
  targetValue Float?
  status      String        @default("HEALTHY") // HEALTHY, WARNING, CRITICAL
  date        DateTime
  createdAt   DateTime      @default(now())

  @@index([kpiId])
  @@index([tenantId])
  @@index([date])
}

/// Threshold Alert Rules for Business Intelligence
model BIAlertRule {
  id                        String    @id @default(uuid())
  tenantId                  String?
  name                      String
  metricKey                 String // REVENUE_DROP, NEGATIVE_REVIEWS, AI_COST_LIMIT, API_FAILURES, PAYMENT_FAILURES, STORAGE_THRESHOLD, SUBSCRIPTION_EXPIRY, CUSTOM_KPI
  condition                 String    @default("GREATER_THAN") // GREATER_THAN, LESS_THAN, EQUALS, CHANGE_PERCENT
  thresholdValue            Float
  severity                  String    @default("HIGH") // LOW, MEDIUM, HIGH, CRITICAL
  channelsJson              String    @default("[\"EMAIL\",\"IN_APP\"]") // EMAIL, WHATSAPP, IN_APP, PUSH
  recipientRoleIdsJson      String    @default("[\"SUPER_ADMIN\",\"ADMIN\"]")
  recipientEmailsJson       String    @default("[]")
  recipientPhoneNumbersJson String    @default("[]")
  isActive                  Boolean   @default(true)
  lastTriggeredAt           DateTime?
  triggerCount              Int       @default(0)
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@index([tenantId])
  @@index([metricKey])
  @@index([isActive])
}

/// Configurable Dashboard Layout Container
model DashboardDefinition {
  id                 String   @id @default(uuid())
  tenantId           String?
  key                String // EXECUTIVE, SYSTEM, ADMIN, PARTNER, CUSTOMER, FINANCE, CRM, AI, GBP, SOCIAL, MARKETING, SALES, CUSTOMER_SUCCESS, SUPPORT, SECURITY, INFRASTRUCTURE, SCORECARD_OWNER, SCORECARD_PARTNER, SCORECARD_CUSTOMER
  title              String
  description        String?
  dashboardType      String   @default("DOMAIN") // DOMAIN, SCORECARD, CUSTOM_USER
  layoutJson         String   @default("[]") // Drag and drop grid layout coordinates [{ id, w, h, x, y, widgetKey }]
  isSystem           Boolean  @default(true)
  isDefault          Boolean  @default(false)
  ownerUserId        String?
  roleVisibilityJson String   @default("[]") // Allowed roles
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  widgets DashboardWidget[]

  @@unique([key, tenantId, ownerUserId])
  @@index([tenantId])
  @@index([key])
}

/// Drag & Drop Dashboard Widget Component
model DashboardWidget {
  id                 String              @id @default(uuid())
  dashboardId        String
  dashboard          DashboardDefinition @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  widgetKey          String
  title              String
  widgetType         String              @default("METRIC_CARD") // METRIC_CARD, CHART, TABLE, FUNNEL, HEATMAP, SCORECARD, AI_INSIGHT, STREAM_LIVE
  chartType          String?             @default("BAR")
  dataEndpoint       String?
  queryConfigJson    String              @default("{}")
  refreshIntervalSec Int                 @default(300)
  gridPositionJson   String              @default("{\"x\":0,\"y\":0,\"w\":4,\"h\":3}")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([dashboardId])
}

/// Predictive Analytics Model Snapshots
model PredictiveModelSnapshot {
  id                      String   @id @default(uuid())
  tenantId                String?
  modelType               String // REVENUE_ARR, CHURN_RISK, CUSTOMER_GROWTH, REVIEW_RATING_TREND, MARKETING_ROI
  forecastDays            Int      @default(30)
  accuracyScore           Float    @default(0.92)
  forecastDataJson        String   @default("[]") // [{ date, predictedValue, lowerBound, upperBound }]
  confidenceInterval      Float    @default(0.95)
  contributingFactorsJson String   @default("[]")
  createdAt               DateTime @default(now())

  @@index([tenantId])
  @@index([modelType])
}

/// Data warehouse and BI integration layer for external platforms (Power BI, Tableau, Looker, Grafana, Snowflake, BigQuery, Databricks)
model BiIntegration {
  id              String    @id @default(uuid())
  tenantId        String?
  name            String
  platformType    String    @default("POWER_BI") // POWER_BI, TABLEAU, LOOKER, GRAFANA, SNOWFLAKE, BIGQUERY, DATABRICKS, POSTGRESQL_SYNC, REST_ODATA
