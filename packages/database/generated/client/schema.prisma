generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Core Tenant Management
// -----------------------------------------------------------------------------

model Tenant {
  id           String  @id @default(uuid())
  name         String
  domain       String? @unique
  subdomain    String? @unique
  logoUrl      String?
  primaryColor String?
  isActive     Boolean @default(true)

  // White-label & Settings
  themeSettingsJson String?
  seoSettingsJson   String?
  featuresJson      String?

  // Soft Delete & Enterprise Audit
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?
  createdBy String?
  updatedBy String?
  version   Int       @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  roles           Role[]
  clients         Client[]
  socialPosts     SocialPost[]
  socialChannels  SocialChannel[]
  aiContents      AiContent[]
  aiConfigs       TenantAiConfig[]
  automationRules AutomationRule[]

  // Billing
  subscriptions Subscription[]
  invoices      Invoice[]

  // Support
  tickets Ticket[]

  // GBP Integrations
  locations Location[]
}

// -----------------------------------------------------------------------------
// Identity & Authentication
// -----------------------------------------------------------------------------

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  firstName     String?
  lastName      String?
  avatarUrl     String?
  isActive      Boolean   @default(true)

  // Phase 2 IAM Enhancements
  phoneNumber             String?
  phoneVerified           DateTime?
  isLocked                Boolean   @default(false)
  lockedUntil             DateTime?
  failedLoginAttempts     Int       @default(0)
  mfaEnabled              Boolean   @default(false)
  mfaType                 String?   @default("TOTP") // TOTP, SMS_OTP, EMAIL_OTP
  mustChangePassword      Boolean   @default(false)
  passwordExpiresAt       DateTime?
  lastPasswordChange      DateTime?
  preferredLanguage       String    @default("en")
  preferredTimezone       String    @default("UTC")
  notificationPreferences String? // JSON settings

  // Approval & Verification
  approvalStatus   String                        @default("APPROVED") // PENDING, APPROVED, REJECTED, SUSPENDED, BLOCKED, ARCHIVED
  isSuspended      Boolean                       @default(false)
  suspensionReason String?
  suspendedAt      DateTime?
  partnerDocuments PartnerVerificationDocument[]
  upgradeRequests  UpgradeRequest[]

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  roles           UserRole[]
  sessions        Session[]
  accounts        ProviderAccount[] // For OAuth
  loginHistory    LoginHistory[]
  devices         Device[]
  passwordHistory PasswordHistory[]
  notifications   Notification[]

  // Soft Delete & Enterprise Audit
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?
  createdBy String?
  updatedBy String?
  version   Int       @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, isDeleted])
}

model Session {
  id             String    @id @default(uuid())
  sessionToken   String    @unique
  userId         String
  expires        DateTime
  revokedAt      DateTime? // Set when session is explicitly invalidated (logout)
  ipAddress      String?
  userAgent      String?
  lastActivityAt DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Used for self-service password reset flow.
/// Token is stored as a SHA-256 hash — raw token is sent via email only.
model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

/// Password history prevention engine (last 5 passwords)
model PasswordHistory {
  id           String   @id @default(uuid())
  userId       String
  passwordHash String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([userId])
}

/// Dynamic enterprise OAuth authentication provider configuration
model AuthProviderConfig {
  id                 String   @id @default(uuid())
  provider           String   @unique // GOOGLE, MICROSOFT, APPLE, GITHUB, FACEBOOK, LINKEDIN
  isEnabled          Boolean  @default(true)
  clientId           String?
  clientSecret       String?
  redirectUri        String?
  callbackUrl        String?
  scopes             String   @default("[]") // JSON array of requested scopes
  additionalSettings String   @default("{}") // JSON settings (branding, domain restrictions)
  tenantId           String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

/// Email & Mobile SMS OTP verification tokens
model VerificationToken {
  id         String   @id @default(uuid())
  identifier String // Email address or Phone number
  token      String // OTP or hash
  type       String // EMAIL_VERIFICATION, MOBILE_OTP, INVITATION
  attempts   Int      @default(0)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([identifier, type])
}

model ProviderAccount {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model MfaSecret {
  id        String   @id @default(uuid())
  userId    String   @unique
  secret    String
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// Role-Based Access Control (RBAC)
// -----------------------------------------------------------------------------

model Role {
  id          String  @id @default(uuid())
  name        String
  description String?

  isSystem Boolean @default(false) // e.g., "Super Admin" can't be deleted

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  permissions RolePermission[]
  users       UserRole[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([name, tenantId]) // Role names must be unique within a tenant
  @@index([tenantId])
}

model Permission {
  id          String  @id @default(uuid())
  resource    String // e.g., "users", "posts", "billing"
  action      String // e.g., "create", "read", "update", "delete", "manage", "approve", "export"
  category    String? @default("GENERAL") // e.g., "MODULE", "MENU", "API", "WORKFLOW", "REPORT"
  scope       String? @default("TENANT") // e.g., "OWN", "DEPARTMENT", "TENANT", "GLOBAL"
  description String?

  roles RolePermission[]

  @@unique([resource, action])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

// -----------------------------------------------------------------------------
// Dynamic Feature Flags & Entitlements
// -----------------------------------------------------------------------------

model FeatureFlag {
  id          String  @id @default(uuid())
  key         String  @unique // e.g., "AI_STUDIO", "GBP_AUTOMATION", "ADVANCED_ANALYTICS"
  name        String
  description String?
  isEnabled   Boolean @default(true)

  // Rule-based Targeting (JSON string format: { tenants: [], plans: [], roles: [] })
  targetRules String @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// Approval Workflows Subsystem
// -----------------------------------------------------------------------------

model ApprovalWorkflow {
  id          String  @id @default(uuid())
  name        String // e.g., "Partner Registration Approval", "Social Content Publishing"
  triggerType String // e.g., "REGISTRATION", "PARTNER_ONBOARDING", "POST_PUBLISH", "BILLING_REFUND"
  description String?
  isActive    Boolean @default(true)
  tenantId    String?

  steps    ApprovalStep[]
  requests ApprovalRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model ApprovalStep {
  id           String           @id @default(uuid())
  workflowId   String
  workflow     ApprovalWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  stepNumber   Int
  title        String
  requiredRole String // Role required to approve e.g. "PARTNER_ADMIN", "SUPER_ADMIN"

  createdAt DateTime @default(now())

  @@index([workflowId])
}

model ApprovalRequest {
  id           String           @id @default(uuid())
  workflowId   String
  workflow     ApprovalWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  requesterId  String
  resourceType String // e.g., "User", "SocialPost", "Client"
  resourceId   String
  currentStep  Int              @default(1)
  status       String           @default("PENDING") // PENDING, APPROVED, REJECTED
  comments     String?
  tenantId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workflowId])
  @@index([tenantId])
  @@index([status])
}

// -----------------------------------------------------------------------------
// Enterprise White-Label & Custom Branding
// -----------------------------------------------------------------------------

model WhiteLabelConfig {
  id             String   @id @default(uuid())
  tenantId       String?  @unique
  appTitle       String   @default("Global Business Suite")
  logoUrl        String?
  faviconUrl     String?
  primaryColor   String   @default("#D4AF37")
  secondaryColor String   @default("#1A1A1A")
  themeMode      String   @default("DARK") // DARK, LIGHT, SYSTEM
  customCss      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// AI Prompt Templates & Versioning Studio
// -----------------------------------------------------------------------------

model PromptTemplate {
  id               String   @id @default(uuid())
  key              String   @unique // e.g., "CAPTION_GENERATOR", "REVIEW_REPLY", "EMAIL_ASSISTANT"
  title            String
  category         String   @default("GENERAL") // MARKETING, SEO, CRM, SALES, SUPPORT, GBP, SOCIAL, ANALYTICS, BILLING, REVIEW, KNOWLEDGE, WORKFLOW, GENERAL
  systemPrompt     String
  userPrompt       String
  variablesJson    String   @default("[]") // JSON array of variables: [{ name, label, defaultValue, required }]
  version          Int      @default(1)
  modelKey         String   @default("gemini-1.5-pro")
  approvalStatus   String   @default("APPROVED") // DRAFT, PENDING_APPROVAL, APPROVED, REJECTED
  approvedByUserId String?
  tenantId         String? // Nullable for global platform system prompts
  tagsJson         String   @default("[]")
  usageCount       Int      @default(0)
  ratingAvg        Float    @default(5.0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([tenantId])
  @@index([category])
  @@index([approvalStatus])
}

// -----------------------------------------------------------------------------
// Notification Templates Control Center
// -----------------------------------------------------------------------------

model NotificationTemplate {
  id        String   @id @default(uuid())
  key       String   @unique // e.g., "WELCOME_EMAIL", "PASSWORD_RESET", "SUSPICIOUS_LOGIN"
  channel   String   @default("EMAIL") // EMAIL, SMS, WHATSAPP, PUSH
  subject   String
  body      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// Platform Settings
// -----------------------------------------------------------------------------

model PlatformSetting {
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// Partner Portal specific models
// -----------------------------------------------------------------------------

model Client {
  id        String   @id @default(uuid())
  firstName String
  lastName  String
  email     String
  phone     String?
  status    String   @default("ACTIVE") // ACTIVE, INACTIVE, LEAD
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Social post — supports multi-platform cross-posting, post types, approval workflows, UTM builder & AI metadata
model SocialPost {
  id        String  @id @default(uuid())
  content   String
  /// Legacy single-platform field kept for backward compat
  platform  String  @default("MULTI")
  /// JSON array of platform keys: ["FACEBOOK","INSTAGRAM","LINKEDIN",...]
  platforms String  @default("[]")
  imageUrls String  @default("[]") // JSON array of image URLs
  videoUrl  String?
  hashtags  String  @default("[]") // JSON array
  linkUrl   String?

  // Phase 11 Extensions
  postType         String  @default("POST") // POST, REEL, STORY, SHORT, CAROUSEL, POLL, EVENT, OFFER, ANNOUNCEMENT, DOCUMENT
  utmParamsJson    String  @default("{}") // UTM builder params: { source, medium, campaign, term, content }
  aiPromptUsed     String?
  brandVoice       String?
  approvalStatus   String  @default("APPROVED") // DRAFT, PENDING, APPROVED, REJECTED
  approvedByUserId String?
  rejectionReason  String?
  version          Int     @default(1)
  isRecurring      Boolean @default(false)
  recurrenceRule   String? // DAILY, WEEKLY, MONTHLY

  scheduledAt     DateTime?
  publishedAt     DateTime?
  status          String                     @default("DRAFT") // DRAFT, PENDING_APPROVAL, SCHEDULED, PUBLISHING, PUBLISHED, FAILED, PARTIALLY_PUBLISHED
  createdByUserId String?
  tenantId        String
  tenant          Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  platformResults SocialPostPlatformResult[]
  postVersions    SocialPostVersion[]
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([scheduledAt])
  @@index([approvalStatus])
}

/// Version history for Social Post drafts and edits
model SocialPostVersion {
  id             String     @id @default(uuid())
  postId         String
  post           SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  versionNumber  Int
  content        String
  platforms      String     @default("[]")
  imageUrls      String     @default("[]")
  videoUrl       String?
  editedByUserId String?
  createdAt      DateTime   @default(now())

  @@index([postId])
}

/// Per-channel publish result for a SocialPost
model SocialPostPlatformResult {
  id             String     @id @default(uuid())
  postId         String
  post           SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  platform       String // FACEBOOK, INSTAGRAM, LINKEDIN, etc.
  channelId      String? // Foreign key to SocialChannel
  status         String     @default("PENDING") // PENDING, PUBLISHED, FAILED
  externalPostId String? // ID returned by platform after publish
  externalUrl    String? // Link to the post on the platform
  error          String? // Error message if failed
  publishedAt    DateTime?
  createdAt      DateTime   @default(now())

  @@index([postId])
}

/// OAuth-connected social media channel per tenant
model SocialChannel {
  id             String    @id @default(uuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  platform       String // FACEBOOK, INSTAGRAM, LINKEDIN, PINTEREST, TIKTOK, THREADS, TWITTER_X, YOUTUBE, GOOGLE_BUSINESS, REDDIT, TELEGRAM, WHATSAPP, SNAPCHAT
  accountId      String // Platform-specific account/page ID
  accountName    String
  accountAvatar  String?
  accessToken    String
  refreshToken   String?
  tokenExpiresAt DateTime?
  scopes         String    @default("[]") // JSON array of granted scopes
  isActive       Boolean   @default(true)

  // Phase 11 Workspace & Health Extensions
  workspaceId       String?
  locationId        String?
  pageId            String?
  healthStatus      String    @default("HEALTHY") // HEALTHY, EXPIRING, EXPIRED, REVOKED
  lastHealthCheckAt DateTime?

  metadata  String   @default("{}") // Platform-specific extra data (JSON)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, platform, accountId])
  @@index([tenantId])
}

// -----------------------------------------------------------------------------
// Phase 11 Media Library, Unified Engagement Inbox, Social Listening & Analytics
// -----------------------------------------------------------------------------

/// Folder structure for Media Library
model MediaFolder {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

/// Enhanced Enterprise Social Media Asset
model SocialMediaAsset {
  id            String   @id @default(uuid())
  tenantId      String
  name          String
  fileUrl       String
  fileType      String // IMAGE, VIDEO, DOCUMENT, BRAND_ASSET, AI_GENERATED
  fileSize      Int      @default(0)
  mimeType      String?
  folderId      String?
  category      String   @default("GENERAL")
  tagsJson      String   @default("[]")
  isBrandAsset  Boolean  @default(false)
  isAiGenerated Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
  @@index([fileType])
  @@index([folderId])
}

/// Centralized Social Media Engagement Conversation Inbox
model SocialEngagementInbox {
  id              String          @id @default(uuid())
  tenantId        String
  platform        String // FACEBOOK, INSTAGRAM, LINKEDIN, TWITTER_X, WHATSAPP, GOOGLE_BUSINESS
  channelId       String?
  conversationId  String          @unique // External conversation/thread ID
  senderName      String?
  senderAvatar    String?
  senderId        String?
  lastMessageText String?
  unreadCount     Int             @default(0)
  status          String          @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  assignedUserId  String?
  messages        SocialMessage[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([tenantId])
  @@index([status])
}

/// Messages in Unified Engagement Inbox
model SocialMessage {
  id                String                @id @default(uuid())
  inboxId           String
  inbox             SocialEngagementInbox @relation(fields: [inboxId], references: [id], onDelete: Cascade)
  externalMessageId String?               @unique
  senderId          String?
  senderName        String?
  messageText       String
  mediaUrl          String?
  isFromCustomer    Boolean               @default(true)
  aiSuggestedReply  String?
  createdAt         DateTime              @default(now())

  @@index([inboxId])
}

/// Comment threads across connected social accounts
model SocialComment {
  id                String    @id @default(uuid())
  tenantId          String
  platform          String
  channelId         String?
  postId            String? // External or internal post ID
  externalCommentId String?   @unique
  authorName        String?
  authorAvatar      String?
  content           String
  sentiment         Float? // -1.0 to +1.0
  status            String    @default("UNREAD") // UNREAD, READ, REPLIED, HIDDEN, DELETED
  assignedUserId    String?
  replyText         String?
  repliedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([tenantId])
  @@index([status])
}

/// Social Listening Rule Monitor
model SocialListeningMonitor {
  id              String             @id @default(uuid())
  tenantId        String
  name            String
  keywordsJson    String             @default("[]") // Brand keywords to track
  competitorsJson String             @default("[]") // Competitor handles to track
  isActive        Boolean            @default(true)
  lastRunAt       DateTime?
  mentions        SocialMention[]
  competitors     SocialCompetitor[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([tenantId])
}

/// Social Listening Brand Mention & Trend Post
model SocialMention {
  id             String                 @id @default(uuid())
  monitorId      String
  monitor        SocialListeningMonitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  tenantId       String
  platform       String // TWITTER_X, REDDIT, LINKEDIN, INSTAGRAM, WEB
  externalId     String?                @unique
  authorName     String?
  content        String
  url            String?
  sentimentScore Float? // Negative (-1) to Positive (+1)
  publishedAt    DateTime?
  createdAt      DateTime               @default(now())

  @@index([monitorId])
  @@index([tenantId])
}

/// Social Listening Competitor Tracker
model SocialCompetitor {
  id             String                 @id @default(uuid())
  monitorId      String
  monitor        SocialListeningMonitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  tenantId       String
  competitorName String
  platform       String
  handle         String
  followersCount Int                    @default(0)
  engagementRate Float                  @default(0.0)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([monitorId])
  @@index([tenantId])
}

/// Social Analytics Periodic Rollup Snapshot
model SocialAnalyticsSnapshot {
  id                 String   @id @default(uuid())
  tenantId           String
  platform           String
  channelId          String?
  date               DateTime
  reach              Int      @default(0)
  impressions        Int      @default(0)
  engagement         Int      @default(0)
  followers          Int      @default(0)
  clicks             Int      @default(0)
  conversions        Int      @default(0)
  bestTimeToPostJson String   @default("[]") // Peak engagement hours JSON array e.g. [9, 14, 18]
  createdAt          DateTime @default(now())

  @@unique([tenantId, platform, date])
  @@index([tenantId])
}

model AiContent {
  id        String   @id @default(uuid())
  prompt    String
  result    String
  type      String   @default("CAPTION") // CAPTION, EMAIL, BLOG, REVIEW_REPLY, GBP_POST, SOCIAL_POST
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now())

  @@index([tenantId])
}

// -----------------------------------------------------------------------------
// Google Business Profile (GBP) Extended Models
// -----------------------------------------------------------------------------

/// Multi-account Google OAuth connection per tenant
model GbpAccount {
  id                 String     @id @default(uuid())
  tenantId           String
  accountName        String
  googleAccountId    String     @unique // e.g. accounts/10923847291
  email              String
  accessToken        String
  refreshToken       String?
  tokenExpiresAt     DateTime?
  accountHealth      String     @default("HEALTHY") // HEALTHY, EXPIRING, EXPIRED, REVOKED, DISCONNECTED
  verificationStatus String     @default("VERIFIED") // VERIFIED, PENDING, UNVERIFIED
  permissionLevel    String     @default("OWNER") // OWNER, MANAGER, SITE_MANAGER
  lastHealthCheckAt  DateTime?
  locations          Location[]
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([tenantId])
}

/// Location Group for multi-location enterprises
model GbpLocationGroup {
  id          String     @id @default(uuid())
  tenantId    String
  name        String
  description String?
  locations   Location[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([tenantId])
}

/// GBP-specific posts (offers, events, what's new, COVID-19 updates)
model GbpPost {
  id                  String    @id @default(uuid())
  locationId          String
  location            Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  topicType           String    @default("STANDARD") // STANDARD, EVENT, OFFER, ALERT, PRODUCT, SERVICE
  covidType           String? // COVID_19_UPDATE, TEMPORARY_CLOSURE
  summary             String
  callToAction        String? // BOOK, ORDER, SHOP, LEARN_MORE, SIGN_UP, CALL
  callToActionUrl     String?
  photoUrl            String?
  videoUrl            String?
  eventTitle          String?
  eventStartDate      DateTime?
  eventEndDate        DateTime?
  couponCode          String?
  redeemOnlineUrl     String?
  termsConditions     String?
  googlePostId        String?   @unique // ID returned by GBP API after publish
  status              String    @default("DRAFT") // DRAFT, PENDING_APPROVAL, APPROVED, REJECTED, SCHEDULED, PUBLISHED, DELETED
  approvalStatus      String    @default("APPROVED") // PENDING, APPROVED, REJECTED
  approvedByUserId    String?
  isRecurring         Boolean   @default(false)
  recurrenceRule      String? // DAILY, WEEKLY, MONTHLY
  templateId          String?
  aiSuggestedHashtags String    @default("[]")
  aiSuggestedImages   String    @default("[]")
  targetLocationIds   String    @default("[]") // For bulk posting across multiple locations
  scheduledAt         DateTime?
  publishedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([locationId])
  @@index([status])
  @@index([approvalStatus])
}

/// Product catalog for a GBP location
model GbpProduct {
  id           String   @id @default(uuid())
  locationId   String
  location     Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  name         String
  category     String?  @default("GENERAL")
  description  String?
  price        Float?
  currency     String   @default("USD")
  imageUrl     String?
  landingPage  String?
  offerCode    String?
  inStock      Boolean  @default(true)
  googleItemId String?  @unique
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([locationId])
}

/// Services offered at a GBP location
model GbpService {
  id           String   @id @default(uuid())
  locationId   String
  location     Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  price        Float?
  currency     String   @default("USD")
  durationMins Int?     @default(30)
  categoryId   String? // GBP service category ID
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([locationId])
}

/// Photos and videos for a GBP location
model GbpMedia {
  id            String   @id @default(uuid())
  locationId    String
  location      Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  mediaFormat   String   @default("PHOTO") // PHOTO, VIDEO
  category      String   @default("ADDITIONAL") // LOGO, COVER, EXTERIOR, INTERIOR, PRODUCT, AT_WORK, FOOD_AND_DRINK, MENU, ADDITIONAL
  googleMediaId String?  @unique
  sourceUrl     String // URL of the media (hosted or GBP-served)
  thumbnailUrl  String?
  description   String?
  isAiSuggested Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([locationId])
}

/// Customer questions for a GBP location (Q&A)
model GbpQuestion {
  id                String      @id @default(uuid())
  locationId        String
  location          Location    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  googleQuestionId  String?     @unique
  authorName        String?
  text              String
  upvoteCount       Int         @default(0)
  aiSuggestedAnswer String?
  assignedUserId    String?
  status            String      @default("UNANSWERED") // UNANSWERED, ANSWERED, AI_SUGGESTED
  createTime        DateTime?
  updateTime        DateTime?
  answers           GbpAnswer[]
  createdAt         DateTime    @default(now())

  @@index([locationId])
}

/// Answers to a GBP Q&A question (owner or top answer)
model GbpAnswer {
  id             String      @id @default(uuid())
  questionId     String
  question       GbpQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  googleAnswerId String?     @unique
  authorName     String?
  isOwnerAnswer  Boolean     @default(false)
  text           String
  upvoteCount    Int         @default(0)
  createTime     DateTime?
  createdAt      DateTime    @default(now())

  @@index([questionId])
}

/// Daily GBP insights snapshot per location
model GbpInsight {
  id                  String   @id @default(uuid())
  locationId          String
  location            Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  date                DateTime
  // Impressions
  businessImpressions Int      @default(0)
  searchKeywordCount  Int      @default(0)
  // Interactions
  callClicks          Int      @default(0)
  websiteClicks       Int      @default(0)
  directionRequests   Int      @default(0)
  bookingClicks       Int      @default(0)
  foodOrderClicks     Int      @default(0)
  // Photos
  photoViewCount      Int      @default(0)
  // Reviews
  reviewCount         Int      @default(0)
  averageRating       Float?
  createdAt           DateTime @default(now())

  @@unique([locationId, date])
  @@index([locationId])
}

/// Customer messages via GBP Messaging API
model GbpMessage {
  id               String    @id @default(uuid())
  locationId       String
  location         Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  googleMessageId  String?   @unique
  customerName     String?
  customerPhone    String?
  messageText      String
  isRead           Boolean   @default(false)
  aiSuggestedReply String?
  assignedUserId   String?
  replyText        String?
  repliedAt        DateTime?
  repliedByUserId  String?
  createTime       DateTime?
  createdAt        DateTime  @default(now())

  @@index([locationId])
}

/// GBP Post Template for reuse
model GbpPostTemplate {
  id              String   @id @default(uuid())
  tenantId        String
  title           String
  topicType       String   @default("STANDARD")
  summary         String
  callToAction    String?
  callToActionUrl String?
  mediaUrlsJson   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
}

/// GBP Review Reply Template for AI / Manual reuse
model GbpReviewReplyTemplate {
  id           String   @id @default(uuid())
  tenantId     String
  name         String
  starRating   Int      @default(5)
  tone         String   @default("professional")
  language     String   @default("en")
  templateText String
  brandVoice   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId])
}

// -----------------------------------------------------------------------------
// Automation Engine
// -----------------------------------------------------------------------------

model AutomationRule {
  id                String    @id @default(uuid())
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  isActive          Boolean   @default(true)
  triggerType       String
  triggerConditions String    @default("{}")
  actionType        String
  actionConfig      String    @default("{}")
  lastRunAt         DateTime?
  runCount          Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([tenantId])
  @@index([isActive])
}

// -----------------------------------------------------------------------------
// AI Engine Configuration
// -----------------------------------------------------------------------------

model AiProvider {
  id                      String    @id @default(uuid())
  name                    String
  providerKey             String    @unique
  apiType                 String    @default("OPENAI")
  baseUrl                 String?
  organizationId          String?
  apiKey                  String?
  priority                Int       @default(1)
  isFallback              Boolean   @default(false)
  isActive                Boolean   @default(true)
  isSelfHosted            Boolean   @default(false)
  healthStatus            String    @default("HEALTHY")
  lastHealthCheckAt       DateTime?
  supportedModalitiesJson String    @default("[\"TEXT\"]")
  rateLimitRpm            Int       @default(600)
  rateLimitTpm            Int       @default(100000)
  costMultiplier          Float     @default(1.0)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  models        AiModel[]
  tenantConfigs TenantAiConfig[]
}

model AiModel {
  id                      String     @id @default(uuid())
  providerId              String
  provider                AiProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  modelKey                String
  name                    String
  description             String?
  contextWindow           Int        @default(128000)
  maxOutputTokens         Int        @default(4096)
  inputCostPer1k          Float      @default(0.0015)
  outputCostPer1k         Float      @default(0.0050)
  supportsStreaming       Boolean    @default(true)
  supportsVision          Boolean    @default(true)
  supportsAudio           Boolean    @default(false)
  supportsEmbeddings      Boolean    @default(false)
  supportsFunctionCalling Boolean    @default(true)
  latencyBenchmarkMs      Int        @default(350)
  qualityScore            Float      @default(9.5)
  isDefault               Boolean    @default(false)
  isActive                Boolean    @default(true)
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @default(now()) @updatedAt

  @@unique([providerId, modelKey])
}

model TenantAiConfig {
  id              String     @id @default(uuid())
  tenantId        String
  tenant          Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  providerId      String
  provider        AiProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  isActive        Boolean    @default(true)
  quotaMonthly    Int        @default(0)
  usageCurrent    Int        @default(0)
  overrideKey     String?
  overrideBaseUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, providerId])
}

// -----------------------------------------------------------------------------
// Billing & Subscriptions
// -----------------------------------------------------------------------------

model Plan {
  id              String  @id @default(uuid())
  name            String
  code            String? @unique
  description     String?
  price           Float
  interval        String  @default("MONTHLY")
  currency        String  @default("USD")
  trialDays       Int     @default(14)
  isActive        Boolean @default(true)
  isCustomPricing Boolean @default(false)

  featuresJson         String @default("[]")
  limitsJson           String @default("{}")
  pricingByCountryJson String @default("{}")

  // Granular Subscription Limits (-1 represents unlimited)
  maxCustomers              Int @default(-1)
  maxEmployees              Int @default(-1)
  maxOrganizations          Int @default(-1)
  maxGoogleAccounts         Int @default(-1)
  maxGoogleBusinessProfiles Int @default(-1)
  maxLocations              Int @default(-1)
  maxSocialAccounts         Int @default(-1)
  maxAiUsage                Int @default(-1)
  maxStorageMb              Int @default(-1)
  maxWhatsAppMessages       Int @default(-1)
  maxSms                    Int @default(-1)
  maxEmails                 Int @default(-1)
  maxCampaigns              Int @default(-1)
  maxPosts                  Int @default(-1)
  maxReviewReplies          Int @default(-1)
  maxCalls                  Int @default(-1)
  maxAppointments           Int @default(-1)
  maxInboxConversations     Int @default(-1)

  // Module level View vs Action permissions JSON map: { "reviews": ["view"], "gbp": ["view", "edit"], "analytics": ["view"] }
  allowedActionsJson String @default("{}")

  subscriptions Subscription[]
  allowedModels String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RegistrationConfig {
  id                           String   @id @default(uuid())
  portal                       String   @unique // ADMIN, PARTNER, CUSTOMER
  allowRegistration            Boolean  @default(true)
  emailVerificationRequired    Boolean  @default(true)
  mobileOtpRequired            Boolean  @default(true)
  whatsAppOtpEnabled           Boolean  @default(false)
  documentUploadRequired       Boolean  @default(false)
  businessVerificationRequired Boolean  @default(false)
  autoApprovalEnabled          Boolean  @default(false)
  defaultPlanId                String?
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
}

model PartnerVerificationDocument {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName     String
  documentType     String // BUSINESS_LICENSE, TAX_CERTIFICATE, IDENTITY_PROOF, UTILITY_BILL
  documentUrl      String
  status           String   @default("PENDING") // PENDING, VERIFIED, REJECTED
  rejectionReason  String?
  verifiedByUserId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model UpgradeRequest {
  id                  String    @id @default(uuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId            String?
  currentPlanId       String?
  requestedPlanId     String
  requestedLimitsJson String    @default("{}")
  reason              String?
  status              String    @default("PENDING") // PENDING, APPROVED, REJECTED
  adminNotes          String?
  paymentTxId         String?
  activatedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([userId])
  @@index([status])
}

model Subscription {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId   String
  plan     Plan   @relation(fields: [planId], references: [id])
  status   String @default("ACTIVE")

  billingCycle       String    @default("MONTHLY")
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  trialStart         DateTime?
  trialEnd           DateTime?
  pausedAt           DateTime?
  resumedAt          DateTime?
  gracePeriodEnd     DateTime?
  canceledAt         DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)
  autoRenew          Boolean   @default(true)

  pricingOverrideJson  String?
  savedPaymentMethodId String?

  addons   SubscriptionAddon[]
  invoices Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
}

model SubscriptionAddon {
  id             String       @id @default(uuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  addonKey       String
  addonName      String
  quantity       Int          @default(1)
  unitPrice      Float
  currency       String       @default("USD")
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())

  @@index([subscriptionId])
}

model EnterpriseLicense {
  id                  String              @id @default(uuid())
  tenantId            String?
  licenseKeyHash      String              @unique
  licenseKeyMasked    String
  licenseType         String              @default("ENTERPRISE")
  status              String              @default("ACTIVE")
  maxSeats            Int                 @default(1)
  allocatedSeats      Int                 @default(0)
  maxDevices          Int                 @default(1)
  maxApiCallsDay      Int                 @default(100000)
  allowedFeaturesJson String              @default("[]")
  metadataJson        String              @default("{}")
  validFrom           DateTime            @default(now())
  validTo             DateTime?
  revokedAt           DateTime?
  revokedReason       String?
  activations         LicenseActivation[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([tenantId])
  @@index([licenseKeyHash])
  @@index([status])
}

model LicenseActivation {
  id            String            @id @default(uuid())
  licenseId     String
  license       EnterpriseLicense @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  activatedBy   String?
  deviceId      String?
  deviceName    String?
  ipAddress     String?
  osInfo        String?
  isActive      Boolean           @default(true)
  activatedAt   DateTime          @default(now())
  deactivatedAt DateTime?

  @@index([licenseId])
  @@index([activatedBy])
}

model PaymentGatewayConfig {
  id                      String   @id @default(uuid())
  gateway                 String   @unique
  name                    String
  isEnabled               Boolean  @default(false)
  isDefault               Boolean  @default(false)
  testMode                Boolean  @default(true)
  credentialsJson         String   @default("{}")
  supportedCurrenciesJson String   @default("[\"USD\"]")
  priority                Int      @default(1)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model SavedPaymentMethod {
  id           String   @id @default(uuid())
  tenantId     String
  userId       String?
  gateway      String
  gatewayToken String
  paymentType  String   @default("CARD")
  cardBrand    String?
  last4        String?
  expMonth     Int?
  expYear      Int?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId])
}

model Invoice {
  id             String        @id @default(uuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  invoiceNumber  String        @unique
  docType        String        @default("INVOICE")
  status         String        @default("OPEN")

  subtotal      Float  @default(0.0)
  taxTotal      Float  @default(0.0)
  discountTotal Float  @default(0.0)
  amount        Float
  currency      String @default("USD")

  billingAddressJson String  @default("{}")
  taxBreakdownJson   String  @default("[]")
  pdfUrl             String?

  dueDate DateTime?
  paidAt  DateTime?

  lineItems InvoiceLineItem[]
  payments  Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([invoiceNumber])
}

model InvoiceLineItem {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  itemType    String   @default("SUBSCRIPTION")
  description String
  quantity    Int      @default(1)
  unitPrice   Float
  amount      Float
  taxRate     Float    @default(0.0)
  createdAt   DateTime @default(now())

  @@index([invoiceId])
}

model Payment {
  id             String   @id @default(uuid())
  invoiceId      String
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount         Float
  currency       String   @default("USD")
  gateway        String   @default("STRIPE")
  paymentType    String   @default("RECURRING")
  status         String   @default("SUCCEEDED")
  referenceId    String?
  gatewayFee     Float    @default(0.0)
  failureReason  String?
  idempotencyKey String?  @unique
  retryCount     Int      @default(0)
  refunds        Refund[]

  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@index([status])
}

model Refund {
  id          String   @id @default(uuid())
  paymentId   String
  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  amount      Float
  currency    String   @default("USD")
  reason      String?
  status      String   @default("SUCCEEDED")
  referenceId String?
  createdAt   DateTime @default(now())

  @@index([paymentId])
}

model TaxRule {
  id           String   @id @default(uuid())
  countryCode  String
  stateRegion  String?
  taxName      String
  taxRate      Float
  isExemptable Boolean  @default(true)
  description  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([countryCode, stateRegion, taxName])
}

model TaxExemption {
  id            String    @id @default(uuid())
  tenantId      String
  countryCode   String
  taxName       String
  certificateNo String
  status        String    @default("APPROVED")
  validUntil    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tenantId])
}

model CouponRedemption {
  id          String   @id @default(uuid())
  couponId    String
  tenantId    String
  invoiceId   String?
  discountAmt Float
  redeemedAt  DateTime @default(now())

  @@index([tenantId])
  @@index([couponId])
}

model UsageRecord {
  id          String   @id @default(uuid())
  tenantId    String
  metricKey   String
  quantity    Int      @default(1)
  unitPrice   Float    @default(0.0)
  totalAmount Float    @default(0.0)
  periodStart DateTime
  periodEnd   DateTime
  isBilled    Boolean  @default(false)
  invoiceId   String?
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([metricKey])
  @@index([isBilled])
}

model PaymentWebhookLog {
  id          String   @id @default(uuid())
  gateway     String
  eventId     String   @unique
  eventType   String
  payloadJson String
  status      String   @default("PROCESSED")
  processedAt DateTime @default(now())

  @@index([gateway])
  @@index([eventId])
}

// -----------------------------------------------------------------------------
