  assignedUserId        String?
  queueName             String?
  status                String   @default("COMPLETED") // RINGING, IN_PROGRESS, COMPLETED, MISSED, VOICEMAIL, TRANSFERRED
  durationSec           Int      @default(0)
  recordingUrl          String?
  voicemailUrl          String?
  callNotes             String?
  ivrPathJson           String   @default("[]")
  aiTranscription       String?
  aiSummary             String?
  aiSentiment           String?  @default("NEUTRAL")
  aiActionItemsJson     String   @default("[]")
  holdDurationSec       Int      @default(0)
  whisperUserId         String?
  conferenceUserIdsJson String   @default("[]")
  createdAt             DateTime @default(now())

  @@index([tenantId])
  @@index([callType])
  @@index([status])
  @@index([assignedUserId])
}

model CallQueueConfig {
  id                String   @id @default(uuid())
  tenantId          String
  queueName         String
  routingType       String   @default("ROUND_ROBIN") // ROUND_ROBIN, PRIORITY, SKILL_BASED
  agentUserIdsJson  String   @default("[]")
  maxWaitTimeSec    Int      @default(300)
  fallbackVoicemail Boolean  @default(true)
  isEnabled         Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([tenantId])
}

model IvrConfig {
  id               String   @id @default(uuid())
  tenantId         String
  name             String
  greetingAudioUrl String?
  menuNodesJson    String   @default("[]")
  isEnabled        Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([tenantId])
}

model CallbackSchedule {
  id             String   @id @default(uuid())
  tenantId       String
  customerId     String?
  phoneNumber    String
  scheduledTime  DateTime
  status         String   @default("PENDING") // PENDING, COMPLETED, CANCELLED
  assignedUserId String?
  notes          String?
  createdAt      DateTime @default(now())

  @@index([tenantId])
  @@index([status])
}

// -----------------------------------------------------------------------------
// 3. Appointment & Booking System Subsystem
// -----------------------------------------------------------------------------

model AppointmentBooking {
  id                  String   @id @default(uuid())
  tenantId            String
  customerId          String?
  customerName        String
  customerEmail       String
  customerPhone       String?
  serviceName         String
  staffId             String?
  staffName           String?
  locationId          String?
  startTime           DateTime
  endTime             DateTime
  status              String   @default("SCHEDULED") // SCHEDULED, CONFIRMED, CHECKED_IN, COMPLETED, RESCHEDULED, CANCELLED
  meetingType         String   @default("IN_PERSON") // IN_PERSON, ZOOM, MS_TEAMS, PHONE
  meetingUrl          String?
  calendarEventIdSync String?
  bufferMinutes       Int      @default(15)
  cancellationReason  String?
  qrCheckInCode       String?  @unique
  reminderSent        Boolean  @default(false)
  paymentStatus       String   @default("NOT_REQUIRED") // NOT_REQUIRED, PENDING, PAID, REFUNDED
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([startTime])
  @@index([staffId])
}

model StaffAvailabilityRule {
  id             String   @id @default(uuid())
  tenantId       String
  staffId        String
  dayOfWeek      Int // 0 (Sun) - 6 (Sat)
  startTime      String // "09:00"
  endTime        String // "17:00"
  breakTimesJson String   @default("[]")
  isAvailable    Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId, staffId])
}

model BookingWidgetConfig {
  id                      String   @id @default(uuid())
  tenantId                String   @unique
  widgetTitle             String   @default("Book an Appointment")
  colorScheme             String   @default("#D4AF37")
  customCss               String?
  allowedServicesJson     String   @default("[]")
  bufferMinutes           Int      @default(15)
  cancellationNoticeHours Int      @default(24)
  isEnabled               Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([tenantId])
}

model CalendarSyncConfig {
  id             String    @id @default(uuid())
  tenantId       String
  userId         String
  provider       String // GOOGLE_CALENDAR, OUTLOOK
  syncCalendarId String?
  accessToken    String?
  refreshToken   String?
  lastSyncedAt   DateTime?
  isEnabled      Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([tenantId, userId, provider])
  @@index([tenantId])
}

model MeetingIntegrationConfig {
  id              String   @id @default(uuid())
  tenantId        String
  provider        String // ZOOM, MS_TEAMS
  apiKey          String?
  apiSecret       String?
  oauthConfigJson String   @default("{}")
  isEnabled       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, provider])
  @@index([tenantId])
}

// -----------------------------------------------------------------------------
// 4. Data Retention & Compliance Export Subsystem
// -----------------------------------------------------------------------------

model DataRetentionPolicy {
  id                String   @id @default(uuid())
  tenantId          String? // null = platform default policy
  countryCode       String?  @default("GLOBAL")
  moduleName        String // INBOX, CALLS, BOOKINGS, AUDIT, AI_LOGS, BILLING, SYSTEM
  retentionDays     Int      @default(365)
  autoCleanupAction String   @default("ARCHIVE") // ARCHIVE, PURGE
  legalHold         Boolean  @default(false)
  createdByUserId   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([tenantId])
  @@index([moduleName])
}

model ArchivedRecordLedger {
  id               String    @id @default(uuid())
  tenantId         String
  moduleName       String
  originalId       String
  archivedDataJson String
  archivedAt       DateTime  @default(now())
  restoredAt       DateTime?
  restoredByUserId String?

  @@index([tenantId])
  @@index([moduleName])
}

model ComplianceExportJob {
  id                String    @id @default(uuid())
  tenantId          String
  requestedByUserId String
  exportType        String // AUDIT_LOGS, ACTIVITY, SECURITY, COMMUNICATION, CUSTOMER, INVOICES, SUBSCRIPTIONS, AI_LOGS, SYSTEM
  format            String    @default("PDF") // PDF, EXCEL, CSV, JSON
  dateRangeStart    DateTime?
  dateRangeEnd      DateTime?
  status            String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  fileUrl           String?
  fileSizeMb        Float     @default(0.0)
  createdAt         DateTime  @default(now())

  @@index([tenantId])
  @@index([status])
}

model EnterpriseComplianceRule {
  id             String   @id @default(uuid())
  tenantId       String?
  ruleName       String
  category       String   @default("SECURITY") // SECURITY, COMPLIANCE, AUDIT, APPROVALS, RETENTION
  severity       String   @default("HIGH")
  conditionsJson String   @default("{}")
  isEnforced     Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId])
}
