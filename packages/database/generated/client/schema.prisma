  apiKeyMasked    String?
  databaseName    String?
  syncFrequency   String    @default("HOURLY") // REALTIME, HOURLY, DAILY, MANUAL
  lastSyncAt      DateTime?
  status          String    @default("ACTIVE") // ACTIVE, INACTIVE, SYNCING, ERROR
  recordsExported Int       @default(0)
  syncConfigJson  String    @default("{}")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

