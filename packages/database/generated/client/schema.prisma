  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceName   String?
  manufacturer String?
  model        String?
  osVersion    String?
  appVersion   String?
  ipAddress    String?
  country      String?
  city         String?
  pushToken    String?
