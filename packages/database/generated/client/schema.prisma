// -----------------------------------------------------------------------------
// -----------------------------------------------------------------------------
// Google Business Profile Integrations
// -----------------------------------------------------------------------------

model Location {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  googleAccountId String?
  googleAccount   GbpAccount? @relation(fields: [googleAccountId], references: [id], onDelete: SetNull)

  locationGroupId String?
  locationGroup   GbpLocationGroup? @relation(fields: [locationGroupId], references: [id], onDelete: SetNull)

  googleLocationId    String  @unique // The unique location name/ID from Google API
  locationName        String?
  title               String? // Business title on Google Maps
  description         String? // Business description
  storeCode           String?
  primaryPhone        String?
  secondaryPhonesJson String  @default("[]")
  email               String?
  websiteUrl          String?
  appointmentUrl      String?
  menuUrl             String?
  bookingUrl          String?
  deliveryUrl         String?
  address             String? // Formatted address

  // Categories & Attributes
  categoriesJson String @default("[]") // Main and additional categories
  attributesJson String @default("{}") // GBP business attributes

  // Hours
  regularHoursJson String @default("{}") // Monday-Sunday opening hours
  specialHoursJson String @default("[]") // Special dates opening hours
  holidayHoursJson String @default("[]") // Public holiday hours

  // Media
  logoUrl       String?
  coverPhotoUrl String?

  // Verification & Account Health
  verificationStatus String @default("VERIFIED") // VERIFIED, UNVERIFIED, PENDING
  permissionLevel    String @default("OWNER") // OWNER, MANAGER
  accountHealth      String @default("HEALTHY") // HEALTHY, WARNING, SUSPENDED

  // Settings & Sync status
  isSyncEnabled Boolean   @default(true)
  lastSyncAt    DateTime?

  reviews      Review[]
  gbpPosts     GbpPost[]
  gbpProducts  GbpProduct[]
  gbpServices  GbpService[]
  gbpMedia     GbpMedia[]
  gbpQuestions GbpQuestion[]
  gbpInsights  GbpInsight[]
  gbpMessages  GbpMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([googleAccountId])
  @@index([locationGroupId])
}

model Review {
  id         String   @id @default(uuid())
  tenantId   String?
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  googleReviewId          String    @unique // The review ID from Google API
  reviewerName            String?
  reviewerProfilePhotoUrl String?
  starRating              Int       @default(0) // STAR_RATING_UNSPECIFIED, ONE, TWO, THREE, FOUR, FIVE mapped to 0-5
  comment                 String?
  createTime              DateTime?
  updateTime              DateTime?

  // Categorization & Tags
  category       String? @default("GENERAL")
  tagsJson       String  @default("[]")
  assignedUserId String?

  // Reply & Moderation
  replyComment     String?
  replyUpdateTime  DateTime?
  moderationStatus String    @default("APPROVED") // PENDING, APPROVED, REJECTED, AUTO_REPLIED
  replyStatus      String    @default("UNREPLIED") // UNREPLIED, PENDING_APPROVAL, REPLIED, FAILED
  replyTone        String?   @default("professional")
  replyLanguage    String?   @default("en")
  replyHistoryJson String    @default("[]")

  // AI/Sentiment
  sentimentScore   Float?
  aiSuggestedReply String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([locationId])
  @@index([starRating])
  @@index([tenantId])
  @@index([moderationStatus])
}

// -----------------------------------------------------------------------------
// Phase 4 Enterprise Hierarchy & Organization Structure
// -----------------------------------------------------------------------------

model Organization {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  tenantId    String?
  description String?
  branches    Branch[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Branch {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  code           String
  address        String?
  departments    Department[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, code])
}

model Department {
  id        String   @id @default(uuid())
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name      String
  teams     Team[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Team {
  id           String     @id @default(uuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  name         String
  leaderId     String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model UserGroup {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  membersJson String   @default("[]") // Array of user IDs
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// Advanced Billing, Pricing Tiers, Coupons & Add-ons
// -----------------------------------------------------------------------------

model Coupon {
  id             String    @id @default(uuid())
  code           String    @unique
  discountType   String    @default("PERCENTAGE") // PERCENTAGE, FIXED_AMOUNT
  discountValue  Float
  maxRedemptions Int?
  timesRedeemed  Int       @default(0)
  validUntil     DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model BillingAddon {
  id          String   @id @default(uuid())
  name        String
  key         String   @unique
  price       Float
  billingUnit String   @default("MONTHLY")
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// CRM, Sales, Marketing & Customer Success Subsystem (Phase 13)
// -----------------------------------------------------------------------------

/// Enterprise Lead record
model CrmLead {
  id                       String    @id @default(uuid())
  tenantId                 String
  source                   String    @default("WEBSITE_FORM") // WEBSITE_FORM, LANDING_PAGE, SOCIAL_MEDIA, GOOGLE_BUSINESS, MANUAL, API, IMPORT
  status                   String    @default("NEW") // NEW, CONTACTED, QUALIFIED, UNQUALIFIED, CONVERTED, NURTURING, LOST
  score                    Int       @default(0) // AI calculated lead score 0-100
  aiInsights               String?
  firstName                String
  lastName                 String?
  email                    String
  phone                    String?
  companyName              String?
  jobTitle                 String?
  industry                 String?
  address                  String?
  city                     String?
  state                    String?
  country                  String?
  assignedUserId           String?
  partnerId                String?
  tagsJson                 String    @default("[]")
  customFieldsJson         String    @default("{}")
  isDuplicate              Boolean   @default(false)
  duplicateOfLeadId        String?
  qualificationNotes       String?
  convertedToContactId     String?
  convertedToOpportunityId String?
  convertedAt              DateTime?
  isDeleted                Boolean   @default(false)
  deletedAt                DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([email])
  @@index([score])
}

/// Automatic Lead Routing Rule
model CrmLeadRoutingRule {
  id                  String   @id @default(uuid())
  tenantId            String
  name                String
  ruleType            String   @default("ROUND_ROBIN") // ROUND_ROBIN, TERRITORY, SOURCE, LOAD_BALANCED
  conditionsJson      String   @default("{}")
  assignedUserIdsJson String   @default("[]")
  priority            Int      @default(1)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([tenantId])
}

/// AI Lead Scoring Rule
model CrmLeadScoringRule {
  id            String   @id @default(uuid())
  tenantId      String
  name          String
  criteriaType  String   @default("DEMOGRAPHIC") // DEMOGRAPHIC, BEHAVIORAL, ENGAGEMENT, FIRMOGRAPHIC
  conditionJson String   @default("{}")
  scoreDelta    Int      @default(10)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
}

/// Lead Capture Website/Landing Form Config
model CrmLeadCaptureForm {
  id                   String   @id @default(uuid())
  tenantId             String
  title                String
  description          String?
  fieldsJson           String   @default("[]")
  embedCode            String?
  targetLandingPageUrl String?
  redirectUrl          String?
  submissionCount      Int      @default(0)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([tenantId])
}

/// B2B Organization / Client Account
model CrmAccount {
  id              String           @id @default(uuid())
  tenantId        String
  name            String
  accountType     String           @default("PROSPECT") // PROSPECT, CUSTOMER, PARTNER, VENDOR
  industry        String?
  website         String?
  phone           String?
  email           String?
  annualRevenue   Float            @default(0)
  employeeCount   Int              @default(0)
  parentAccountId String?
  branchId        String?
  billingAddress  String?
  shippingAddress String?
  healthScore     Int              @default(100) // 0-100
  assignedUserId  String?
  tagsJson        String           @default("[]")
  segmentsJson    String           @default("[]")
  isDeleted       Boolean          @default(false)
  deletedAt       DateTime?
  contacts        CrmContact[]
  opportunities   CrmOpportunity[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([tenantId])
  @@index([accountType])
}

/// Individual Contact Person
model CrmContact {
  id                           String           @id @default(uuid())
  tenantId                     String
  accountId                    String?
  account                      CrmAccount?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  firstName                    String
  lastName                     String?
  email                        String
  phone                        String?
  mobilePhone                  String?
  designation                  String?
  communicationPreferencesJson String           @default("{\"email\":true,\"sms\":true,\"whatsapp\":true,\"push\":true}")
  relationshipsJson            String           @default("[]")
  tagsJson                     String           @default("[]")
  segmentsJson                 String           @default("[]")
  assignedUserId               String?
  isDeleted                    Boolean          @default(false)
  deletedAt                    DateTime?
  opportunities                CrmOpportunity[]
  createdAt                    DateTime         @default(now())
  updatedAt                    DateTime         @updatedAt

  @@index([tenantId])
  @@index([accountId])
  @@index([email])
}

/// CRM Sales Pipeline
model CrmPipeline {
  id          String     @id @default(uuid())
  tenantId    String?
  name        String
  description String?
  isDefault   Boolean    @default(false)
  isDeleted   Boolean    @default(false)
  stages      CrmStage[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([tenantId])
}

/// CRM Sales Stage
model CrmStage {
  id             String           @id @default(uuid())
  pipelineId     String
  pipeline       CrmPipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name           String
  order          Int              @default(0)
  winProbability Int              @default(50)
  isWonStage     Boolean          @default(false)
  isLostStage    Boolean          @default(false)
  opportunities  CrmOpportunity[]
  createdAt      DateTime         @default(now())

  @@index([pipelineId])
}

/// CRM Deal Opportunity
model CrmOpportunity {
  id                 String        @id @default(uuid())
  tenantId           String?
  stageId            String
  stage              CrmStage      @relation(fields: [stageId], references: [id], onDelete: Cascade)
  accountId          String?
  account            CrmAccount?   @relation(fields: [accountId], references: [id], onDelete: SetNull)
  contactId          String?
  contact            CrmContact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  leadId             String?
  title              String
  companyName        String?
  contactName        String?
  contactEmail       String?
  value              Float         @default(0)
  probability        Int           @default(50)
  status             String        @default("OPEN") // OPEN, WON, LOST
  expectedCloseDate  DateTime?
  closedAt           DateTime?
  winLossReason      String?
  winLossCategory    String?
  competitorName     String?
  aiScore            Int           @default(50)
  aiDealInsightsJson String        @default("{}")
  assignedToId       String?
  partnerId          String?
  isDeleted          Boolean       @default(false)
  activities         CrmActivity[]
  documents          CrmDocument[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([stageId])
  @@index([tenantId])
  @@index([status])
}

/// CRM Activity & Communication Log
model CrmActivity {
  id            String          @id @default(uuid())
  tenantId      String?
  opportunityId String?
  opportunity   CrmOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  leadId        String?
  accountId     String?
  contactId     String?
  type          String          @default("NOTE") // NOTE, CALL, EMAIL, MEETING, TASK, WHATSAPP, SMS, APPOINTMENT
  subject       String
  details       String?
  outcome       String?
  durationMins  Int             @default(15)
  scheduledAt   DateTime?
  completedAt   DateTime?
  remindersJson String          @default("[]")
  location      String?
  meetingUrl    String?
  performedBy   String?
  createdAt     DateTime        @default(now())

  @@index([opportunityId])
  @@index([tenantId])
  @@index([leadId])
}

/// Marketing Audience Segment
model MarketingAudienceSegment {
  id           String   @id @default(uuid())
  tenantId     String
  name         String
  description  String?
  criteriaJson String   @default("{}")
  memberCount  Int      @default(0)
  isDynamic    Boolean  @default(true)
  tagsJson     String   @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId])
}

/// Marketing Journey Automation Builder Flow
model MarketingJourney {
  id              String   @id @default(uuid())
  tenantId        String
  name            String
  description     String?
  status          String   @default("DRAFT") // DRAFT, ACTIVE, PAUSED, COMPLETED
  triggerType     String   @default("LEAD_CREATED") // LEAD_CREATED, OPPORTUNITY_STAGE_CHANGED, SCORE_THRESHOLD, FORM_SUBMITTED, MANUAL
  nodesJson       String   @default("[]")
  edgesJson       String   @default("[]")
  entryCount      Int      @default(0)
  completionCount Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
}

/// A/B Testing Variant for Marketing Campaigns
model MarketingCampaignAbVariant {
  id              String            @id @default(uuid())
  campaignId      String
  campaign        MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  variantName     String
  subject         String?
  content         String
  percentageSplit Int               @default(50)
  opens           Int               @default(0)
  clicks          Int               @default(0)
  conversions     Int               @default(0)
  createdAt       DateTime          @default(now())

  @@index([campaignId])
}

/// Customer Health Score Matrix
model CustomerHealthScore {
  id                 String   @id @default(uuid())
  tenantId           String
  accountId          String?
  clientId           String?
  overallScore       Int      @default(100) // 0-100
  scoreCategory      String   @default("HEALTHY") // HEALTHY, NEUTRAL, AT_RISK, CRITICAL
  npsScore           Float?
  csatScore          Float?
  usageActivityScore Int      @default(100)
  supportTicketScore Int      @default(100)
  billingScore       Int      @default(100)
  aiChurnRiskScore   Float    @default(0.0) // 0 to 100%
  aiChurnReason      String?
  metricsJson        String   @default("{}")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([tenantId])
  @@index([scoreCategory])
}

/// Customer Success Onboarding & Goal Plan
model CustomerSuccessPlan {
  id                   String    @id @default(uuid())
  tenantId             String
  accountId            String?
  clientId             String?
  title                String
  status               String    @default("DRAFT") // DRAFT, ACTIVE, COMPLETED, ON_HOLD
  targetCompletionDate DateTime?
  milestonesJson       String    @default("[]")
  assignedUserId       String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([tenantId])
  @@index([status])
}

/// Customer Feedback (NPS & CSAT)
model CustomerFeedback {
  id                String   @id @default(uuid())
  tenantId          String
  accountId         String?
  clientId          String?
  type              String   @default("NPS") // NPS, CSAT, GENERAL, EXIT
  rating            Int      @default(10) // 1-10 for NPS or 1-5 for CSAT
  comments          String?
  category          String?  @default("PRODUCT") // PRODUCT, SUPPORT, BILLING, ONBOARDING
  followUpStatus    String   @default("UNTOUCHED") // UNTOUCHED, IN_PROGRESS, RESOLVED
  respondedByUserId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([tenantId])
  @@index([type])
}

/// Customer Renewal & Expansion Pipeline
model CustomerRenewalUpsell {
  id            String    @id @default(uuid())
  tenantId      String
  accountId     String?
  clientId      String?
  opportunityId String?
  type          String    @default("RENEWAL") // RENEWAL, UPSELL, CROSS_SELL
  currentMrr    Float     @default(0)
  targetMrr     Float     @default(0)
  probability   Int       @default(50)
  targetDate    DateTime?
  status        String    @default("IDENTIFIED") // IDENTIFIED, IN_PROGRESS, WON, LOST
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tenantId])
  @@index([type])
  @@index([status])
}

/// CRM Document, Quotes, Contracts & Proposals
model CrmDocument {
  id                       String          @id @default(uuid())
  tenantId                 String
  opportunityId            String?
  opportunity              CrmOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  leadId                   String?
  accountId                String?
  contactId                String?
  name                     String
  docType                  String          @default("QUOTE") // QUOTE, CONTRACT, AGREEMENT, PROPOSAL, ATTACHMENT, TEMPLATE
  fileUrl                  String
  fileSize                 Int             @default(0)
  status                   String          @default("DRAFT") // DRAFT, SENT, VIEWED, ACCEPTED, SIGNED, REJECTED, EXPIRED
  totalAmount              Float           @default(0)
  validUntil               DateTime?
  digitalSignatureDataJson String          @default("{}")
  version                  Int             @default(1)
  createdByUserId          String?
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  @@index([tenantId])
  @@index([docType])
  @@index([status])
}

// -----------------------------------------------------------------------------
// API Gateway Keys & Webhook Subscriptions
// -----------------------------------------------------------------------------

model ApiKey {
  id         String    @id @default(uuid())
  tenantId   String?
  name       String
  keyHash    String    @unique
  prefix     String
  scopesJson String    @default("[\"*\"]")
  rateLimit  Int       @default(1000) // requests per hour
  expiresAt  DateTime?
  lastUsedAt DateTime?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([tenantId])
}

model WebhookSubscription {
  id            String    @id @default(uuid())
  tenantId      String?
  targetUrl     String
  secret        String
  eventsJson    String    @default("[\"*\"]")
  isActive      Boolean   @default(true)
  failureCount  Int       @default(0)
  lastTriggerAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tenantId])
}

// -----------------------------------------------------------------------------
// Media Storage & Backups Engine
// -----------------------------------------------------------------------------

model StorageBucket {
  id            String   @id @default(uuid())
  provider      String   @default("LOCAL") // LOCAL, S3, GCS, AZURE
  bucketName    String   @unique
  region        String?
  maxStorageGb  Int      @default(100)
  usedStorageMb Float    @default(0)
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model BackupLog {
  id            String   @id @default(uuid())
  type          String   @default("FULL") // FULL, INCREMENTAL
  status        String   @default("COMPLETED") // PENDING, COMPLETED, FAILED
  fileSizeBytes Float?
  backupPath    String?
  checksum      String?
  createdAt     DateTime @default(now())
}

// -----------------------------------------------------------------------------
// Search Bookmarks & Dashboard Dynamic Preferences
// -----------------------------------------------------------------------------

model SavedSearch {
  id          String   @id @default(uuid())
  userId      String
  name        String
  query       String
  filtersJson String   @default("{}")
  createdAt   DateTime @default(now())

  @@index([userId])
}

model DashboardLayout {
  id         String   @id @default(uuid())
  userId     String   @unique
  layoutJson String   @default("[]") // Array of active widget IDs & positions
  updatedAt  DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// Phase 5 Enterprise Partner Portal Subsystems
// -----------------------------------------------------------------------------

model MarketingCampaign {
  id              String                       @id @default(uuid())
  name            String
  type            String                       @default("EMAIL") // EMAIL, SMS, WHATSAPP, PUSH, OMNICHANNEL
  channel         String                       @default("EMAIL")
  status          String                       @default("DRAFT") // DRAFT, SCHEDULED, ACTIVE, COMPLETED, PAUSED
  audienceSegment String                       @default("ALL")
  content         String
  subject         String?
  scheduledAt     DateTime?
  sentAt          DateTime?
  metricsJson     String                       @default("{}") // { sent: 0, opened: 0, clicked: 0, converted: 0 }
  tenantId        String
  abVariants      MarketingCampaignAbVariant[]
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt

  @@index([tenantId])
  @@index([status])
}

model CalendarEvent {
  id             String   @id @default(uuid())
  title          String
  description    String?
  eventType      String   @default("MEETING") // MEETING, APPOINTMENT, TASK, REMINDER, EVENT
  startTime      DateTime
  endTime        DateTime
  isRecurring    Boolean  @default(false)
  recurrenceRule String? // DAILY, WEEKLY, MONTHLY
  location       String?
  attendeesJson  String   @default("[]")
  assignedUserId String?
  tenantId       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId])
  @@index([startTime])
}

model TaskItem {
  id             String    @id @default(uuid())
  title          String
  description    String?
  status         String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, CANCELLED
  priority       String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  dueDate        DateTime?
  assignedUserId String?
  tenantId       String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([tenantId])
  @@index([status])
}

model MediaAsset {
  id        String   @id @default(uuid())
  name      String
  fileUrl   String
  fileType  String // IMAGE, VIDEO, DOCUMENT, MARKETING_ASSET, AI_GENERATED
  fileSize  Int      @default(0)
  category  String   @default("GENERAL")
  tagsJson  String   @default("[]")
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([fileType])
}

model ScheduledReport {
  id             String    @id @default(uuid())
  title          String
  reportType     String // BUSINESS, REVENUE, LEADS, GBP, SOCIAL, AI, MARKETING, REVIEWS, SEO, PRODUCTIVITY
  frequency      String    @default("WEEKLY") // DAILY, WEEKLY, MONTHLY
  recipientsJson String    @default("[]") // Array of email addresses
  format         String    @default("PDF") // PDF, CSV, JSON
  lastRunAt      DateTime?
  isActive       Boolean   @default(true)
  tenantId       String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([tenantId])
}

// -----------------------------------------------------------------------------
// Phase 6 Enterprise Customer Portal Subsystems
// -----------------------------------------------------------------------------

model CustomerOrder {
  id             String   @id @default(uuid())
  orderNumber    String   @unique
  status         String   @default("PROCESSING") // PENDING, PROCESSING, SHIPPED, DELIVERED, CANCELLED, REFUNDED
  itemsJson      String   @default("[]")
  total          Float    @default(0)
  currency       String   @default("USD")
  paymentStatus  String   @default("PAID") // UNPAID, PAID, REFUNDED
  trackingNumber String?
  notes          String?
  tenantId       String
  clientId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId])
  @@index([clientId])
}

model CustomerAppointment {
  id              String   @id @default(uuid())
  title           String
  serviceId       String?
  appointmentTime DateTime
  durationMins    Int      @default(30)
  status          String   @default("BOOKED") // BOOKED, CONFIRMED, CANCELLED, COMPLETED
  meetingLink     String?
  notes           String?
  tenantId        String
  clientId        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
  @@index([clientId])
}

model CustomerQuotation {
  id          String    @id @default(uuid())
  quoteNumber String    @unique
  totalAmount Float     @default(0)
  status      String    @default("SENT") // DRAFT, SENT, ACCEPTED, REJECTED
  validUntil  DateTime?
  pdfUrl      String?
  tenantId    String
  clientId    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId])
  @@index([clientId])
}

model CustomerInvoice {
  id            String    @id @default(uuid())
  invoiceNumber String    @unique
  amount        Float     @default(0)
  status        String    @default("UNPAID") // DRAFT, UNPAID, PAID, OVERDUE, CANCELLED
  dueDate       DateTime?
  paidAt        DateTime?
  pdfUrl        String?
  tenantId      String
  clientId      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tenantId])
  @@index([clientId])
}

model CustomerLoyalty {
  id             String   @id @default(uuid())
  clientId       String   @unique
  pointsBalance  Int      @default(0)
  tier           String   @default("BRONZE") // BRONZE, SILVER, GOLD, PLATINUM
  lifetimeEarned Int      @default(0)
  tenantId       String
  updatedAt      DateTime @updatedAt

  @@index([tenantId])
}

model CustomerDocument {
  id        String   @id @default(uuid())
  name      String
  docType   String   @default("DOCUMENT") // INVOICE, RECEIPT, CONTRACT, AGREEMENT, REPORT, USER_UPLOAD
  fileUrl   String
  fileSize  Int      @default(0)
  sharedBy  String   @default("SYSTEM") // SYSTEM, PARTNER, CUSTOMER
  tenantId  String
  clientId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([clientId])
}

// -----------------------------------------------------------------------------
// Phase 9 Master Data Lookup Subsystems
// -----------------------------------------------------------------------------

model Country {
  id           String   @id @default(uuid())
  code         String   @unique // ISO 3166-1 alpha-2 e.g. "US", "IN", "GB"
  name         String
  phoneCode    String // e.g. "+1", "+91"
  currencyCode String // e.g. "USD", "INR"
  isActive     Boolean  @default(true)
  states       State[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model State {
  id        String   @id @default(uuid())
  countryId String
  country   Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  code      String // e.g. "CA", "NY", "MH"
  name      String
  cities    City[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([countryId, code])
  @@index([countryId])
}

model City {
  id        String   @id @default(uuid())
  stateId   String
  state     State    @relation(fields: [stateId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stateId])
}

model Currency {
  id           String   @id @default(uuid())
  code         String   @unique // e.g. "USD", "EUR", "INR", "GBP"
  name         String
  symbol       String   @default("$")
  exchangeRate Float    @default(1.0) // Rate relative to USD baseline
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Language {
  id         String   @id @default(uuid())
  code       String   @unique // ISO 639-1 e.g. "en", "es", "fr", "hi"
  name       String
  nativeName String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model TaxRate {
  id          String   @id @default(uuid())
  name        String // e.g. "GST Standard", "State Sales Tax"
  percentage  Float
  countryCode String   @default("US")
  isCompound  Boolean  @default(false)
  tenantId    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
}

model BusinessCategory {
  id          String   @id @default(uuid())
  key         String   @unique // e.g. "RETAIL", "HEALTHCARE", "REST_BAR", "SALON_SPA"
  name        String
  description String?
  industry    String   @default("GENERAL")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// Phase 9 In-App User Notifications Subsystem
// -----------------------------------------------------------------------------

model Notification {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId     String?
  type         String    @default("INFO") // INFO, SUCCESS, WARNING, ALERT, SYSTEM
  title        String
  body         String
  isRead       Boolean   @default(false)
  readAt       DateTime?
  actionUrl    String?
  metadataJson String    @default("{}")
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([userId, isRead])
  @@index([tenantId])
}

model AiEmbedding {
  id           String   @id @default(uuid())
  tenantId     String?
  resourceType String // KnowledgeBase, Review, SocialPost, Client, Product
  resourceId   String
  vectorJson   String // JSON string of float embedding vector
  contentHash  String // SHA-256 string for cache invalidation
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([resourceType, resourceId])
  @@index([tenantId])
}

// -----------------------------------------------------------------------------
// Phase 9 Enterprise Audit & Field Delta Change History
// -----------------------------------------------------------------------------

model AuditChangeLog {
  id          String   @id @default(uuid())
  tenantId    String?
  userId      String?
  entityType  String // User, Subscription, Location, Plan, SocialPost, Invoice
  entityId    String
  action      String // CREATE, UPDATE, DELETE, RESTORE
  changesJson String // JSON diff { field: { old: val, new: val } }
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}

// =============================================================================
// PHASE 12 – ENTERPRISE AI PLATFORM, AI AGENTS & AUTOMATION
// =============================================================================

// -----------------------------------------------------------------------------
// AI Agents Catalog & Configuration
// -----------------------------------------------------------------------------

model AiAgent {
  id                   String   @id @default(uuid())
  key                  String   @unique // MARKETING_AGENT, SEO_AGENT, CRM_AGENT, SUPPORT_AGENT, etc.
  name                 String
  description          String?
  agentType            String   @default("GENERAL") // MARKETING, SEO, CRM, SALES, SUPPORT, GBP, SOCIAL, ANALYTICS, BILLING, REVIEW, KNOWLEDGE, WORKFLOW, ADMIN, PARTNER, CUSTOMER, DEVELOPER
  systemPrompt         String
  defaultModelKey      String   @default("gemini-1.5-pro")
  providerKey          String   @default("gemini")
  temperature          Float    @default(0.7)
  maxTokens            Int      @default(2048)
  toolsJson            String   @default("[]") // JSON array of tool names the agent can call
  knowledgeBaseIdsJson String   @default("[]") // JSON array of bound knowledge base IDs
  tenantId             String? // null = global platform agent
  isActive             Boolean  @default(true)
  isSystemAgent        Boolean  @default(true) // Platform defaults vs custom tenant agents
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  executions AiAgentExecution[]

  @@index([tenantId])
  @@index([agentType])
  @@index([isActive])
}

model AiAgentExecution {
  id                String   @id @default(uuid())
  agentId           String
  agent             AiAgent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  tenantId          String?
  userId            String?
  userPrompt        String
  systemInstruction String
  response          String
  providerKey       String
  modelKey          String
  promptTokens      Int      @default(0)
  completionTokens  Int      @default(0)
  totalTokens       Int      @default(0)
  estimatedCost     Float    @default(0.0)
  latencyMs         Int      @default(0)
  citationsJson     String   @default("[]")
  status            String   @default("SUCCESS") // SUCCESS, ERROR, GOVERNANCE_BLOCKED
  createdAt         DateTime @default(now())

  @@index([agentId])
  @@index([tenantId])
  @@index([userId])
  @@index([createdAt])
}

// -----------------------------------------------------------------------------
// AI Workflow Automation Engine
// -----------------------------------------------------------------------------

model AiWorkflow {
  id                String    @id @default(uuid())
  tenantId          String?
  name              String
  description       String?
  triggerType       String    @default("MANUAL") // SCHEDULED, EVENT, WEBHOOK, MANUAL
  triggerConfigJson String    @default("{}") // cron expression, event name, webhook URL
  stepsJson         String    @default("[]") // JSON array of pipeline steps
  isActive          Boolean   @default(true)
  runCount          Int       @default(0)
  lastRunAt         DateTime?
  lastRunStatus     String? // SUCCESS, ERROR, RUNNING
  createdByUserId   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  runs AiWorkflowRun[]

  @@index([tenantId])
  @@index([triggerType])
  @@index([isActive])
}

model AiWorkflowRun {
  id           String     @id @default(uuid())
  workflowId   String
  workflow     AiWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  tenantId     String?
  triggeredBy  String     @default("SYSTEM") // SYSTEM, USER, WEBHOOK, CRON
  status       String     @default("RUNNING") // RUNNING, SUCCESS, FAILED, CANCELLED
  inputJson    String     @default("{}")
  outputJson   String     @default("{}")
  errorMessage String?
  durationMs   Int?
  createdAt    DateTime   @default(now())
  completedAt  DateTime?

  @@index([workflowId])
  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
}

// -----------------------------------------------------------------------------
// AI Knowledge Base & RAG Vector Document Store
// -----------------------------------------------------------------------------

model AiKnowledgeBase {
  id            String   @id @default(uuid())
  tenantId      String?
  name          String
  description   String?
  category      String   @default("GENERAL") // SUPPORT, PRODUCT, POLICY, TRAINING, GENERAL
  isActive      Boolean  @default(true)
  documentCount Int      @default(0)
  chunkCount    Int      @default(0)
  embeddingDim  Int      @default(64) // Embedding vector dimension
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  documents AiDocument[]

  @@index([tenantId])
  @@index([category])
}

model AiDocument {
  id              String          @id @default(uuid())
  knowledgeBaseId String
  knowledgeBase   AiKnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  tenantId        String?
  title           String
  fileUrl         String
  fileType        String          @default("TXT") // PDF, DOCX, EXCEL, CSV, PPTX, IMAGE, WEB_PAGE, TXT
  fileSize        Int             @default(0)
  status          String          @default("PENDING") // PENDING, PROCESSING, INDEXED, FAILED
  chunkCount      Int             @default(0)
  errorMessage    String?
  metadataJson    String          @default("{}")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  chunks AiDocumentChunk[]

  @@index([knowledgeBaseId])
  @@index([tenantId])
  @@index([status])
}

model AiDocumentChunk {
  id           String     @id @default(uuid())
  documentId   String
  document     AiDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tenantId     String?
  chunkIndex   Int
  content      String
  tokenCount   Int        @default(0)
  vectorJson   String // JSON array of float embeddings (normalized 64-dim)
  metadataJson String     @default("{}")
  createdAt    DateTime   @default(now())

  @@index([documentId])
  @@index([tenantId])
  @@index([documentId, chunkIndex])
}

// -----------------------------------------------------------------------------
// AI Governance, Safety, PII & Budget Control
// -----------------------------------------------------------------------------

model AiGovernancePolicy {
  id                    String   @id @default(uuid())
  tenantId              String? // null = global platform policy
  name                  String
  description           String?
  policyType            String   @default("CONTENT_SAFETY") // CONTENT_SAFETY, PII_MASKING, RATE_LIMIT, BUDGET_CAP, PROMPT_AUDIT
  isActive              Boolean  @default(true)
  rulesJson             String   @default("{}") // Policy-specific configuration JSON
  budgetCapUSD          Float? // Monthly budget cap in USD
  rateLimitRpm          Int? // Rate limit: requests per minute
  rateLimitTpm          Int? // Rate limit: tokens per minute
  forbiddenKeywordsJson String   @default("[]")
  piiPatternsJson       String   @default("[]")
  severityLevel         String   @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  auditLogs AiGovernanceAuditLog[]

  @@index([tenantId])
  @@index([policyType])
  @@index([isActive])
}

model AiGovernanceAuditLog {
  id            String             @id @default(uuid())
  policyId      String
  policy        AiGovernancePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  tenantId      String?
  userId        String?
  eventType     String // PII_DETECTED, UNSAFE_PROMPT, RATE_LIMIT_HIT, BUDGET_EXCEEDED
  severity      String             @default("MEDIUM")
  detailsJson   String             @default("{}")
  promptSnippet String?
  wasBlocked    Boolean            @default(false)
  createdAt     DateTime           @default(now())

  @@index([policyId])
  @@index([tenantId])
  @@index([eventType])
  @@index([createdAt])
}

// -----------------------------------------------------------------------------
// Enhanced AI Usage Log (Phase 12 – Agent/Workflow/Cost Tracking)
// -----------------------------------------------------------------------------

model AiUsageLog {
  id                String   @id @default(uuid())
  tenantId          String?
  userId            String?
  agentId           String? // Which AI Agent handled this request
  workflowId        String? // Which AI Workflow triggered this request
  providerKey       String // openai, anthropic, gemini, cursor
  modelKey          String // gpt-4o, gemini-1.5-pro, claude-3-5-sonnet
  promptTokens      Int      @default(0)
  completionTokens  Int      @default(0)
  totalTokens       Int      @default(0)
  estimatedCost     Float    @default(0.0)
  latencyMs         Int      @default(0)
  status            String   @default("SUCCESS") // SUCCESS, ERROR, QUOTA_EXCEEDED, GOVERNANCE_BLOCKED
  errorMessage      String?
  feedbackRating    Int? // 1-5 star user satisfaction rating
  isFailoverUsed    Boolean  @default(false)
  governanceFlagged Boolean  @default(false)
  createdAt         DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([agentId])
  @@index([workflowId])
  @@index([providerKey, modelKey])
  @@index([createdAt])
  @@index([status])
}

